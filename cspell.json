{
  "version": "0.2",
  "language": "fr",
  "dictionaries": ["fr"],
  "languageSettings": [
    {
      "languageId": "xml",
      "ignoreRegExpList": [
        "<sage[\\s\\S]*?<\\/sage>",
        "<latex[\\s\\S]*?<\\/latex>",
        "<sageplot[\\s\\S]*?<\\/sageplot>",
        "<pre[\\s\\S]*?<\\/pre>",
        "<code[\\s\\S]*?<\\/code>",
        "\\$\\$[\\s\\S]*?\\$\\$",
        "\\$[^\\$]*\\$",
        "\\\\begin\\{[a-zA-Z*]+\\}[\\s\\S]*?\\\\end\\{[a-zA-Z*]+\\}",
        "<!--[\\s\\S]*?-->"
      ]
    }
  ],
  "ignorePaths": [
    "generated-assets/**",
    "assets/**",
    "external/**",
    "output/**",
    ".git/**"
  ],
  "words": [
    "Pretext",
    "sageplot",
    "LaTeX",
    "ptx"
  ]
}
