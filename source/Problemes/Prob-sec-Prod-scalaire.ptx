  <!-- Section 1.3 Produit scalaire -->
  <exercise>
    <statement><p>
    Soit <m>\va=\llt a_1,a_2\rgt</m>. Calculer la projection de <m>\va</m> sur
    <m>\vi</m> et <m>\vj</m>.
    </p></statement>

    <answer><p>
    <m>\text{proj}_{\vi}\va=a_1\vi</m>
    <m>\text{proj}_{\vj}\va=a_2\vj</m>.
    </p></answer>

    <solution><p>
    <m>\text{proj}_{\vi}\va=(\va\cdot\vi)\vi
    =a_1\vi</m> et
    <m>\text{proj}_{\vj}\va=(\va\cdot\vj)\vj
    =a_2\vj</m>.
    </p></solution>
  </exercise>

