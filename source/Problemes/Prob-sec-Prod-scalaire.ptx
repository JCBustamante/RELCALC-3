  <m>\text{proj}_{\vj}\va=a_2\vj</m>.
  </p></answer>

  <solution><p>
  <m>\text{proj}_{\vi}\va=(\va\cdot\vi)\vi
  =a_1\vi</m> and
  <m>\text{proj}_{\vj}\va=(\va\cdot\vj)\vj
  =a_2\vj</m>.
  </p></solution>
  </exercise>
