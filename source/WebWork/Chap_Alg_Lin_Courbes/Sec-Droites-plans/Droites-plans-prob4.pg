## DBsubject(Géométrie)
## DBchapter(Géométrie vectorielle)
## KEYWORDS('distance', 'droite', 'point', 'produit scalaire', 'produit vectoriel', 'projection orthogonale', 'équations paramétriques')
## Adaptation(Mélisande Fortin Boisvert - Collège de Maisonneuve)
## Traduction française : Sylvie Charbonneau
##########################################SOURCE##################
## ZDate(8/23/07)
## ZInstitution(Union College)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.3')
## Problem1('25')
##########################################SOURCE##################
##Level(2)
##Language(fr) 

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGunion.pl",
  "MathObjects.pl",
  "parserVectorUtils.pl",
  "PGcourse.pl",
);


TEXT(beginproblem());

##############################################
#  Setup

Context("Vector")->variables->are(t=>'Real');
Context()->noreduce('(-x)-y','(-x)+y');  

#
#  The point P and the line p+tv
#
$P = non_zero_point3D();
$p = non_zero_point3D();
$v = non_zero_vector3D();
($P1,$P2,$P3) = $P->value;
($p1,$p2,$p3) = $p->value;
($v1,$v2,$v3) = $v->value;

$pP = Vector($P-$p);
$L = Line($p,$v);

#
#  The projection and distance
#
$perp = $pP - (($pP.$v)/($v.$v)) * $v;
$D = norm($perp);

##############################################
#  Main text

Context()->texStrings;
BEGIN_TEXT

Soit la droite  \(\Delta:\ \mathbf{x} = \left[\begin{array}{r} $p1\\ $p2 \\ $p3\end{array}\right] + t\left[\begin{array}{r} $v1\\ $v2 \\ $v3\end{array}\right]\) et le point  \(P($P1,$P2,$P3)\).
$PAR
Quelle est la distance entre le point \(P\) et la droite \(\Delta\)? \{ans_rule(15)\}.

END_TEXT


Context()->normalStrings;

ANS($D->cmp);

$showPartialCorrectAnswers = 1;



ENDDOCUMENT();
