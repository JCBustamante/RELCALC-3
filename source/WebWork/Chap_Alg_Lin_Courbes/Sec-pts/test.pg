## DBsubject(Algèbre linéaire)
## DBchapter(Vecteurs et espace euclidien)
## KEYWORDS('R^3', 'arithmétique vectorielle', 'produit scalaire', 'vecteur')
## Adaptation(Mélisande Fortin Boisvert - Collège de Maisonneuve)
## Traduction française : Sylvie Charbonneau
##########################################SOURCE##################
## ZInstitution(University of Michigan)
## ZAuthor(Gavin LaRose)
## ZTitleText1('Calculus')
## ZAuthorText1('Hughes-Hallett')
## ZEditionText1('5')
## ZSection1('13.3')
## ZProblem1('5')
## ZTitleText2('Calculus')
## ZAuthorText2('Hughes-Hallett')
## ZEditionText2('6')
## ZSection2('13.3')
## ZProblem2('5')
##########################################SOURCE##################

##Level(1)
##Language(fr)


DOCUMENT();

loadMacros(
"PGstandard.pl",
"parserVectorUtils.pl",
"PGchoicemacros.pl",
"MathObjects.pl",
 "PGcourse.pl",
"contextLimitedVector.pl"
);


Context("LimitedVector");
Context()->flags->set( ijk=>1 );

Context()->constants->set(
  i => {TeX => "\,\mathit{\mathbf i}"},
  j => {TeX => "\,\mathit{\mathbf j}"},
  k => {TeX => "\,\mathit{\mathbf k}"},
);

$showPartialCorrectAnswers = 1;

$a = Vector( (0, random(1,5,1), random(1,5,1)) );
$b = Vector( (non_zero_random(-5,5,1), random(1,8,1), random(1,8,1)) );
$c = Vector( (random(1,5,1), non_zero_random(-8,8,1), 0) );
$y = Vector( (non_zero_random(-8,8,1), non_zero_random(-8,8,1), 0) );



$aans = ($c.$a) + ($a.$y);
$bans = ($a . $b)*$a;
$cans = ($c . $c)*($a . $a);


$aans1 = ($a . Vector(0,1,0))*($c . Vector(0,1,0));
$aans2 = ($a . Vector(0,1,0))*($y . Vector(0,1,0));
$adb = $a . $b;
$cdc = $c . $c;
$ada = $a . $a;

Context()->texStrings;
TEXT(beginproblem());
BEGIN_TEXT
Soit \(\mathbf a\), \(\mathbf b\), \(\mathbf c\) et \(\mathbf y\) des vecteurs dans l'espace :
\[ \mathbf a = $a,\quad \mathbf b = $b,\quad \mathbf c = $c,\quad \mathbf y = $y \]

$PAR
Effectuer les opérations suivantes sur les vecteurs.
$PAR
${BBOLD}a)$EBOLD
\(\mathbf c\cdot\mathbf a + \mathbf a\cdot\mathbf y = \) \{ ans_rule(35) \}

$PAR
${BBOLD}b)$EBOLD
\((\mathbf a\cdot\mathbf b)\,\mathbf a = \) \{ ans_rule(35) \}

$PAR
${BBOLD}c)$EBOLD
\( ( (\mathbf c\cdot\mathbf c)\,\mathbf a )\cdot\mathbf a = \) \{ ans_rule(35) \}

END_TEXT
Context()->normalStrings;



ANS($aans->cmp() );
ANS($bans->cmp() );
ANS($cans->cmp() );



Context()->texStrings;
SOLUTION(EV3(<<'END_SOLUTION'));
$PAR SOLUTION $PAR

${BBOLD}a)$EBOLD
\( \mathbf c\cdot \mathbf a + \mathbf a \cdot \mathbf y =
    ($c)\cdot($a) + ($a)\cdot($y) = $aans1 + $aans2 = $aans. \)

$PAR
${BBOLD}b)$EBOLD
\( (\mathbf a\cdot\mathbf b)\mathbf a =
    (($a)\cdot($b)) ($a) = ($adb) ($a) = $bans. \)

$PAR
${BBOLD}c)$EBOLD
\( ( (\mathbf c\cdot\mathbf c)\mathbf a )\cdot\mathbf a =
    ((($c)\cdot($c)) ($a))\cdot ($a) =
    (($cdc)($a))\cdot ($a) =
    ($cdc)($ada) = $cans. \)


END_SOLUTION
Context()->normalStrings;



ENDDOCUMENT();
