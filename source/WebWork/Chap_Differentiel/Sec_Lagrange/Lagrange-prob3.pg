## DESCRIPTION
##   Extrema absolus avec contraintes
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Calculus - multivariable)
## DBchapter(Differentiation of multivariable functions)
## DBsection(Lagrange multipliers and constrained optimization)
## Institution(ASU)
## MLT(ThreeVarTwoConstraints)
## MLTleader(1)
## Level(3)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Stewart')
## EditionText1('6')
## Section1('14.8')
## Problem1('')
## KEYWORDS('extrema', 'multiplicateurs de Lagrange', 'optimisation sous contraintes', 'plusieurs variables')

## SOURCE
## /Library/272/setStewart14_8/problem_8.pg

DOCUMENT();
loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraphmacros.pl",
  "Dartmouthmacros.pl",
  "PGcourse.pl"
);


## Do NOT show partial correct answers
$showPartialCorrectAnswers = 0;

$a = non_zero_random(-10,10);
$r = random(1,20);



## Ok, we are ready to begin the problem...
##
TEXT(beginproblem());


BEGIN_TEXT
$BR

Trouvez les valeurs maximale et minimale de la fonction \(f(x,y,z) = 3x - y -3z\)
sous les contraintes \(x^2 + 2z^2 = \{$r*$r\}\) et \(x + y - z = $a\).

La valeur maximale est \{ans_rule()\}, atteinte en
(\{ans_rule(15)\}, \{ans_rule(15)\}, \{ans_rule(15)\}).

La valeur minimale est \{ans_rule()\}, atteinte en
(\{ans_rule(15)\}, \{ans_rule(15)\}, \{ans_rule(15)\}).
$PAR
END_TEXT

ANS(num_cmp(-$a + 12*$r/sqrt(6)));
ANS(num_cmp(2*$r/sqrt(6)));
ANS(num_cmp($a - 3*$r/sqrt(6)));
ANS(num_cmp(-$r/sqrt(6)));
ANS(num_cmp(-$a - 12*$r/sqrt(6)));
ANS(num_cmp(-2*$r/sqrt(6)));
ANS(num_cmp($a + 3*$r/sqrt(6)));
ANS(num_cmp($r/sqrt(6)));
ENDDOCUMENT();
