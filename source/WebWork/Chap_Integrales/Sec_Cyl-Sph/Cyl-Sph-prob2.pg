DOCUMENT();
loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraphmacros.pl",
  "Dartmouthmacros.pl",
  "PGcourse.pl"
);
 

## Do NOT show partial correct answers
$showPartialCorrectAnswers = 1;

$b = random(2,9);
$n = random(1,6);
$a = $n*$b;
$aa = $a**2;

TEXT(beginproblem());


BEGIN_TEXT
$BR
Évaluez l'intégrale triple

\( \iiint_{\mathcal{E}} z \, dV \), où \(\mathcal{E}\) est le solide
délimité par le cylindre  \(  y^2+  z^2 = $aa \) et les plans
\( x = 0 \), \( y = $b x \) et \( z =0 \), dans le premier octant.
  $PAR
\{ans_rule(40)\}

$PAR
END_TEXT


ANS(num_cmp($a**4/(8*$b)));

ENDDOCUMENT();
