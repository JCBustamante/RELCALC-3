DOCUMENT();		# This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

$ml = new_match_list();

$ml -> qa(
	"\( \displaystyle \int_{0}^{1}\!\!\int_{y^{2}}^{\sqrt{y}} 
	 4x^{2} + 3y^{2} \: dx dy \)",
	"Solide sous un paraboloide elliptique, sur une région plane bornée par deux paraboles",
	"\( \displaystyle \int_{-2}^{2}\!\!\int_{4}^{4 + \sqrt{4-x^{2}}} 
	 4x + 3y \: dy dx \)",
	"Solide sous un plan, sur une moitié d'un disque ",
	"\( \displaystyle \int_{-1}^{1}\!\!\int_{-\sqrt{1-x^{2}}}^{\sqrt{1-x^{2}}} 
	 1 - x^{2} - y^{2}\: dy dx \)",
	"Solide borné par un paraboloide circulaire et un plan.",
	"\( \displaystyle \int_{0}^{2}\!\!\int_{-2}^{2} \sqrt{4 - y^{2}} \: dy dx \)",
	"La moitié d'une barre cylindrique.",
	"\( \displaystyle \int_{0}^{\frac{1}{\sqrt{3}}}\!\!\int_{0}^{\frac{1}{2}\sqrt{1-3y^{2}}} 
	 \sqrt{1 -4x^{2} - 3y^{2}} \: dx dy \)",
	"Le huitième d'un ellipsoide."
);

$ml -> choose(5);

BEGIN_TEXT
Associez les intégrales suivantes avec la description des solides dont elles calculent le volume. Entrez la lettre de la description à la gauche de l'intégrale correspondante.$BR
\{ $ml -> print_q \}
$PAR
\{ $ml -> print_a \}
END_TEXT

ANS(str_cmp( $ml->ra_correct_ans ) );

ENDDOCUMENT();		# This should be the last executable line in the problem.
