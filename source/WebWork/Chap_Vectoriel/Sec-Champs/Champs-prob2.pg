# DESCRIPTION
# Ligne de courant d'un champ de vecteurs — choix multiple
# ENDDESCRIPTION

## DBsubject(Calculus - multivariable)
## DBchapter(Vector fields)
## DBsection(Graphs, flows lines, and level surfaces)
## Institution(Université de Sherbrooke)
## Author(Juan Carlos Bustamante, avec l'aide de Claude)
## Level(2)
## MO(1)
## KEYWORDS('champ de vecteurs', 'ligne de courant', 'courbe paramétrée')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserPopUp.pl",
  "PGcourse.pl"
);

Context("Numeric");
$showPartialCorrectAnswers = 1;

$a = list_random(1, 2, 3);

# Courbe : r(t) = (cos(at), sin(at)),  r(0) = (1, 0)
# r'(t) = (-a sin(at), a cos(at)) = (-a y(t), a x(t))
# Champ correct  : F = -ay i + ax j   (rotation CCW de vitesse a)
# Distracteur 1  : F =  ay i - ax j   (rotation CW de vitesse a)
# Distracteur 2  : F =  ax i + ay j   (champ radial)

if ($a == 1) {
    $Fcorrect = "-y\,\mathbf{i} + x\,\mathbf{j}";
    $Fclock   = "y\,\mathbf{i} - x\,\mathbf{j}";
    $Fradial  = "x\,\mathbf{i} + y\,\mathbf{j}";
    $curve    = "\cos(t)\,\mathbf{i} + \sin(t)\,\mathbf{j}";
    $rp       = "-\sin(t)\,\mathbf{i} + \cos(t)\,\mathbf{j}";
    $FevalOK  = "-\sin(t)\,\mathbf{i} + \cos(t)\,\mathbf{j}";
} else {
    $Fcorrect = "-${a}y\,\mathbf{i} + ${a}x\,\mathbf{j}";
    $Fclock   = "${a}y\,\mathbf{i} - ${a}x\,\mathbf{j}";
    $Fradial  = "${a}x\,\mathbf{i} + ${a}y\,\mathbf{j}";
    $curve    = "\cos($a t)\,\mathbf{i} + \sin($a t)\,\mathbf{j}";
    $rp       = "-$a\sin($a t)\,\mathbf{i} + $a\cos($a t)\,\mathbf{j}";
    $FevalOK  = "-$a\sin($a t)\,\mathbf{i} + $a\cos($a t)\,\mathbf{j}";
}

# Placer le bon champ à la position aléatoire I, II ou III
$which = random(1, 3, 1);
if ($which == 1) {
    $field1 = $Fcorrect; $field2 = $Fclock; $field3 = $Fradial;
    $correct = "I";
} elsif ($which == 2) {
    $field1 = $Fclock; $field2 = $Fcorrect; $field3 = $Fradial;
    $correct = "II";
} else {
    $field1 = $Fclock; $field2 = $Fradial; $field3 = $Fcorrect;
    $correct = "III";
}

$popup = PopUp(["?", "I", "II", "III"], $correct);

Context()->texStrings;
TEXT(beginproblem());
BEGIN_TEXT

Considérer la courbe paramétrée
\[
  \mathbf{r}(t) = $curve, \qquad \mathbf{r}(0) = (1,\, 0).
\]
Parmi les trois champs de vecteurs suivants, lequel admet cette courbe
comme ligne de courant passant par \((1, 0)\)?
$PAR
\(\qquad\) ${BBOLD}I.$EBOLD \(\quad \mathbf{F}(x,y) = $field1\) $BR
\(\qquad\) ${BBOLD}II.$EBOLD \(\quad \mathbf{F}(x,y) = $field2\) $BR
\(\qquad\) ${BBOLD}III.$EBOLD \(\quad \mathbf{F}(x,y) = $field3\)
$PAR
Réponse : \{ $popup->menu() \}

END_TEXT
Context()->normalStrings;

ANS( $popup->cmp() );

Context()->texStrings;
SOLUTION(EV3(<<'END_SOLUTION'));
$PAR SOLUTION $PAR

Une courbe \(\mathbf{r}(t)\) est une ligne de courant du champ \(\mathbf{F}\) si
\(\mathbf{r}\,'(t) = \mathbf{F}(\mathbf{r}(t))\) pour tout \(t\), et si la condition
initiale est satisfaite.
$PAR
On calcule \(\mathbf{r}\,'(t) = $rp\).
$PAR
Pour le champ $correct, on évalue \(\mathbf{F}\) le long de la courbe :
\[
  \mathbf{F}(\mathbf{r}(t)) = $FevalOK = \mathbf{r}\,'(t). \checkmark
\]
La condition initiale est satisfaite : \(\mathbf{r}(0) = (1, 0)\). \(\checkmark\)

END_SOLUTION
Context()->normalStrings;

ENDDOCUMENT();
