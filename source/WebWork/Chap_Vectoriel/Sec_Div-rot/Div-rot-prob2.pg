# DESCRIPTION
# Problem from Calculus, multi-variable, Hughes-Hallett et al.,
# originally from 5ed (with updates)
# WeBWorK problem written by Gavin LaRose, <glarose@umich.edu>

## Tagged by glr 07/28/10


## DBsubject(Calculus - multivariable)
## DBchapter(Vector calculus)
## DBsection(Curl and divergence)
## Date(07/28/10)
## Institution(University of Michigan)
## Author(Gavin LaRose)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## TitleText2('Calculus')
## TitleText3('Calculus')
## AuthorText1('Hughes-Hallett')
## AuthorText2('Hughes-Hallett')
## AuthorText3('Hughes-Hallett')
## EditionText1('5')
## EditionText2('6')
## EditionText3('7')
## Section1('20.1')
## Section2('19.3')
## Section3('19.3')
## Problem1('9')
## Problem2('11')
## Problem3('10')
## KEYWORDS('divergence', 'vector field', 'multivariable', 'calculus')

## Textbook tags
## HHChapter1('Calculus of Vector Fields')

## source
## Library/Michigan/Chap20Sec1/Q09.pg"

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "MathObjects.pl",
  "PGcourse.pl"
);

Context("Vector");
Context()->flags->set( ijk=>1 );
Context()->constants->set(
  i => {TeX => "\,\mathit{\mathbf{i}}"},
  j => {TeX => "\,\mathit{\mathbf{j}}"},
  k => {TeX => "\,\mathit{\mathbf{k}}"},
);
$showPartialCorrectAnswers = 1;

$r = Vector(Compute("x"), Compute("y"), Compute("z"));
@a = (Compute(random(1,9)), Compute(random(1,9)), Compute(random(1,9)));
$a = Vector(@a);

$rxa = Vector( Compute("$a[1]*z - $a[2]*y"),
	       Compute("$a[2]*x - $a[0]*z"),
	       Compute("$a[0]*y - $a[1]*x") );
@rxaval = $rxa->value;
$div = $rxaval[0]->D('x') + $rxaval[1]->D('y') + $rxaval[2]->D('z');

Context()->texStrings;
TEXT(beginproblem());
BEGIN_TEXT

Calculez la divergence du champ de vecteurs \(\mathbf{F} = \mathbf{a}\times \vec\mathbf{r}\),
si \(\mathbf{r} = $r\) et \(\mathbf{a} = $a\), en calculant d'abord le produit vectoriel.

$PAR
\(\mathbf{F} = \) \{ ans_rule(35) \}
$BR
de sorte que
\(\mbox{div }\mathbf{F} = \) \{ ans_rule(35) \}

END_TEXT
Context()->normalStrings;

ANS($rxa->cmp() );
ANS($div->cmp() );

Context()->texStrings;
SOLUTION(EV3(<<'END_SOLUTION'));
$PAR SOLUTION $PAR

En utilisant la formule du produit vectoriel \(\vec a \times \vec r\) en coordonnées cartésiennes, on obtient
\[ \mathbf{F} = $rxa, \]
de sorte que
\[ \mbox{div }\mathbf{F} = $div. \]


END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();
