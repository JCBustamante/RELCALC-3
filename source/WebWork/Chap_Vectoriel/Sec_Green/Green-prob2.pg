## DESCRIPTION
## Calcul vectoriel — Théorème de Green, flux sortant
## ENDDESCRIPTION

## DBsubject(Calculus - multivariable)
## DBchapter(Fundamental theorems)
## DBsection(Green's theorem)
## Level(3)
## MO(1)
## KEYWORDS('théorème de Green', 'flux', 'divergence', 'champ de vecteurs')

## source
## Thomas' Calculus, section sur le théorème de Green

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

Context("Numeric");

$a = random(2, 8, 1);
$b = random(2, 8, 1);
$two_a = 2*$a;
$two_b = 2*$b;

$answer = Real($a + $b);

$boundary = "\partial\mathcal{D}";
$domain   = "\mathcal{D}";
$FF       = "\mathbf{F}";

Context()->texStrings;
BEGIN_TEXT
$PAR
Utilisez le théorème de Green pour calculer le flux du champ 
\($FF = ($a x^2 + y)\,\mathbf{i} + (x + $b y^2)\,\mathbf{j}\)
à travers la frontière (vers l'extérieur) du carré \($domain\) délimité par \(x=0\), \(x=1\),
\(y=0\) et \(y=1\), parcouru dans le sens antihoraire.
$PAR
\(\displaystyle\oint_{$boundary} $FF \cdot \mathbf{n}\,ds = \) \{ans_rule(20)\}
$PAR
END_TEXT
Context()->normalStrings;

ANS($answer->cmp());

Context()->texStrings;
SOLUTION(EV3(<<'END_SOLUTION'));
$PAR SOLUTION $PAR

On a \(P = $a x^2 + y\) et \(Q = x + $b y^2\), d'où
\[
\frac{\partial P}{\partial x}+\frac{\partial Q}{\partial y} = $two_a x + $two_b y.
\]
Le théorème de Green donne
\[
\iint_{$domain}\left($two_a x + $two_b y\right)dA
= \int_0^1\!\int_0^1 \left($two_a x + $two_b y\right)dx\,dy
= \int_0^1 \left[$a x^2 + $two_b xy\right]_{x=0}^{x=1} dy
= \int_0^1 \left($a + $two_b y\right)dy
= \Bigl[$a y + $b y^2\Bigr]_0^1
= $a + $b = $answer.
\]

END_SOLUTION
Context()->normalStrings;

ENDDOCUMENT();
