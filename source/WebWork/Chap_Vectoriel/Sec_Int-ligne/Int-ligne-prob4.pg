# DESCRIPTION
# Flux d'un champ de vecteurs à travers un triangle — calcul direct
# ENDDESCRIPTION

## DBsubject(Calculus - multivariable)
## DBchapter(Vector calculus)
## DBsection(Line integrals)
## Institution(Université de Sherbrooke)
## Author(Juan Carlos Bustamante)
## Level(3)
## MO(1)
## KEYWORDS('flux', 'intégrale de ligne', 'triangle', 'champ de vecteurs')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGcourse.pl"
);

Context("Numeric");
$showPartialCorrectAnswers = 1;

$a = random(2, 8, 2);     # toujours pair → réponse entière garantie
$b = random(1, 5, 1);
$c = random(1, 4, 1);
do { $d = random(1, 4, 1); } until ($d != $c);

$ctex = ($c == 1) ? '' : $c;
$dtex = ($d == 1) ? '' : $d;

$cd   = $c + $d;
$ans  = Real($cd * $a * $b / 2);

Context()->texStrings;
TEXT(beginproblem());
BEGIN_TEXT

Calculer le flux vers l'extérieur du champ de vecteurs
\(\mathbf{F}(x,y) = $ctex x\,\mathbf{i} + $dtex y\,\mathbf{j}\)
à travers la frontière \(\mathcal{C}\) du triangle de sommets
\(O = (0,0)\), \(A = ($a,\, 0)\) et \(B = (0,\, $b)\),
où \(\mathcal{C}\) est orientée dans le sens antihoraire.
$PAR
Rappel : le flux de \(\mathbf{F} = P\,\mathbf{i} + Q\,\mathbf{j}\) à travers
\(\mathcal{C}\) est donné par
\(\displaystyle \int_{\mathcal{C}} P\,dy - Q\,dx\).
$PAR
Flux \(=\) \{ans_rule(20)\}

END_TEXT
Context()->normalStrings;

ANS($ans->cmp());

Context()->texStrings;
SOLUTION(EV3(<<'END_SOLUTION'));
$PAR SOLUTION $PAR

On décompose \(\mathcal{C}\) en trois segments parcourus dans le sens antihoraire :
\(\mathcal{C}_1 : O \to A\),
\(\mathcal{C}_2 : A \to B\),
\(\mathcal{C}_3 : B \to O\).
$PAR
On a \(P(x,y) = $ctex x\) et \(Q(x,y) = $dtex y\).
$PAR
${BBOLD}Segment \(\mathcal{C}_1\) (\(O \to A\), sur l'axe des \(x\)) :${EBOLD}
Paramétrisation : \(\mathbf{r}(t) = ($a t,\ 0)\), \(t \in [0,1]\).
On a \(dy = 0\) et \(Q = $dtex \cdot 0 = 0\), donc la contribution est nulle.
$PAR
${BBOLD}Segment \(\mathcal{C}_2\) (\(A \to B\), hypoténuse) :${EBOLD}
Paramétrisation : \(\mathbf{r}(t) = ($a(1-t),\ $b t)\), \(t \in [0,1]\),
d'où \(dx = -$a\,dt\) et \(dy = $b\,dt\).
\[
\int_{\mathcal{C}_2} P\,dy - Q\,dx
= \int_0^1 \Bigl[$c \cdot $a(1-t)\cdot $b
               - $d \cdot $b t \cdot(-$a)\Bigr]\,dt
= \int_0^1 \bigl[$c \cdot $a \cdot $b(1-t)
               + $d \cdot $a \cdot $b\, t\bigr]\,dt.
\]
\[
= $c \cdot $a \cdot $b \Bigl[t - \tfrac{t^2}{2}\Bigr]_0^1
+ $d \cdot $a \cdot $b \Bigl[\tfrac{t^2}{2}\Bigr]_0^1
= \frac{$c \cdot $a \cdot $b}{2} + \frac{$d \cdot $a \cdot $b}{2}
= \frac{$cd \cdot $a \cdot $b}{2}.
\]
$PAR
${BBOLD}Segment \(\mathcal{C}_3\) (\(B \to O\), sur l'axe des \(y\)) :${EBOLD}
Paramétrisation : \(\mathbf{r}(t) = (0,\ $b(1-t))\), \(t \in [0,1]\).
On a \(dx = 0\) et \(P = $ctex \cdot 0 = 0\), donc la contribution est nulle.
$PAR
Flux total \(= \dfrac{$cd \cdot $a \cdot $b}{2} = $ans\).

END_SOLUTION
Context()->normalStrings;

ENDDOCUMENT();
