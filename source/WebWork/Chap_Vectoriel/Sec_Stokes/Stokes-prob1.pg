DOCUMENT();		# This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

$a = random(1, 9, 1);
$b = random(1, 9, 1);
$c = $a**2;

BEGIN_TEXT
Utilisez le Théorème de Stokes pour évaluer 
\( \displaystyle \int_{C} \mathbf{F} \cdot d\mathbf{r} \) où 
\( \mathbf{F}(x, y, z) = x\mathbf{i} + y\mathbf{j} + 
  $b\!(x^{2} + y^{2})\mathbf{k} \) 
et \( C \) est le bord de la portion du paraboloïde  
\( z = $c - x^{2} - y^{2} \) se trouvant au dessus du plan \(xy\) et  
\( C \) est orientée dans le sens contraire des aiguilles d'une montre
lorsque vue d'en haut.
$PAR
\{ ans_rule(40) \}
END_TEXT

ANS(num_cmp( 0 ) );

ENDDOCUMENT();		# This should be the last executable line in the problem.
